######################################
# Symfony Environment Files
######################################

# Ignore local environment overrides (never commit secrets)
.env.local
.env.*.local
.env.local.php

# Keep .env committed (contains default safe values)
# DO NOT ignore .env


######################################
# Symfony Cache & Logs
######################################

# Cache, logs and temporary files
/var/


######################################
# Dependencies
######################################

# Composer dependencies (will be installed with composer install)
/vendor/

# Node dependencies (if using npm/yarn)
/node_modules/


######################################
# Public Build & Assets
######################################

# Compiled assets (AssetMapper or Webpack)
/public/assets/
/assets/vendor/
/public/build/

# Symfony generated bundles
/public/bundles/


######################################
# Uploaded Files
######################################

# Ignore everything in uploads
/public/uploads/*

# Allow tricks directory (keep folder structure)
!/public/uploads/tricks/

# Ignore everything inside tricks
/public/uploads/tricks/*

# Allow only fixtures (versioned test images)
!/public/uploads/tricks/fixtures/
!/public/uploads/tricks/fixtures/*

# Allow avatars folder but ignore its content (user uploads)
!/public/uploads/avatars/
/public/uploads/avatars/*

######################################
# PHPUnit & Testing
######################################

/.phpunit.cache/
/phpunit.xml.local


######################################
# IDE & OS Files
######################################

# IDE
/.idea/
/.vscode/

# OS
.DS_Store
Thumbs.db


######################################
# Symfony Secrets (Production)
######################################

/config/secrets/prod/prod.decrypt.private.php

###> friendsofphp/php-cs-fixer ###
/.php-cs-fixer.php
/.php-cs-fixer.cache
###< friendsofphp/php-cs-fixer ###
