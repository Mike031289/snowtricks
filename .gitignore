######################################
# Symfony Environment Files
######################################
# Ignore local environment overrides (never commit secrets)
.env.local
.env.*.local
.env.local.php
# Keep .env committed as it contains default safe values

######################################
# Symfony Cache, Logs & Tools
######################################
# Ignore temporary runtime files
/var/
/.phpunit.cache/
/phpunit.xml.local
/.php-cs-fixer.cache

######################################
# Dependencies
######################################
# Dependencies are managed by Composer and NPM/Yarn
/vendor/
/node_modules/

######################################
# Public Build & Assets
######################################
# Ignore compiled assets, they will be regenerated on each machine
/public/assets/
/assets/vendor/
/public/build/
/public/bundles/

######################################
# Uploaded Files (Data)
######################################
# Ignore all user-uploaded files in production/dev
/public/uploads/*

# Optional: To keep empty directories in the repository,
# add a .gitkeep file inside them and uncomment these lines:
# !/public/uploads/avatars/.gitkeep
# !/public/uploads/tricks/.gitkeep

######################################
# Fixtures Sources (Development)
######################################
# Force Git to track these test images even if other rules exclude them
!/assets/fixtures/
!/assets/fixtures/**

######################################
# Symfony Secrets
######################################
# Never commit the private decryption key for production
/config/secrets/prod/prod.decrypt.private.php
