{% extends 'base.html.twig' %}
{% block title %}
    Page d'inscription
{% endblock %}
{% block body %}
    <div class="container" style="max-width: 500px;">
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger" role="alert">
                {{ flash_error }}
            </div>
        {% endfor %}
        <h1 class="h2 mb-4 text-center">
            <i class="bi bi-person-plus me-2"></i>
            Inscription
        </h1>
        {# Global form errors #}
        {{ form_errors(registrationForm) }}
        {{ form_start(registrationForm, {
        'attr': {
            'novalidate': 'novalidate'
        }
    }) }}
        {# Username #}
        <div class="mb-3">
            {{ form_label(registrationForm.username) }}
            {{ form_widget(registrationForm.username, {
            'attr': {
                'class': 'form-control ' ~ (registrationForm.username.vars.errors|length ? 'is-invalid' : '')
            }
        }) }}
            <div class="invalid-feedback d-block">
                {{ form_errors(registrationForm.username) }}
            </div>
        </div>
        {# Email #}
        <div class="mb-3">
            {{ form_label(registrationForm.email) }}
            {{ form_widget(registrationForm.email, {
            'attr': {
                'class': 'form-control ' ~ (registrationForm.email.vars.errors|length ? 'is-invalid' : '')
            }
        }) }}
            <div class="invalid-feedback d-block">
                {{ form_errors(registrationForm.email) }}
            </div>
        </div>
        {# Password #}
        <div class="mb-3">
            {{ form_label(registrationForm.plainPassword, 'Mot de passe') }}
            {{ form_widget(registrationForm.plainPassword, {
            'attr': {
                'class': 'form-control ' ~ (registrationForm.plainPassword.vars.errors|length ? 'is-invalid' : '')
            }
        }) }}
            <div class="invalid-feedback d-block">
                {{ form_errors(registrationForm.plainPassword) }}
            </div>
        </div>
        {# Terms checkbox #}
        <div class="form-check mb-3">
            {{ form_widget(registrationForm.agreeTerms, {
            'attr': {
                'class': 'form-check-input ' ~ (registrationForm.agreeTerms.vars.errors|length ? 'is-invalid' : '')
            }
        }) }}
            {{ form_label(registrationForm.agreeTerms, null, {
            'label_attr': {'class': 'form-check-label'}
        }) }}
            <div class="invalid-feedback d-block">
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>
        </div>
        {# Hidden fields (CSRF, etc.) #}
        {{ form_rest(registrationForm) }}
        <button type="submit" class="btn btn-success w-100 mt-3">
            <i class="bi bi-check-lg me-2"></i>
            S'inscrire
        </button>
        {{ form_end(registrationForm) }}
        <p class="mt-3 text-center">
            Vous avez déjà un compte ?
            <a href="{{ path('app_login') }}">
                Connectez-vous
            </a>
        </p>
    </div>
{% endblock %}
