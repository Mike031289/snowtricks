{# ================= CAROUSEL IMAGES ================= #}
<div class="position-relative mb-4">
    <div class="row mt-5 mb-4">
        <div class="col-md-6">
            <h3>
                {# Dynamique Calculate total images number #}
                {{ images|length > 0 ? images|length : 1 }}
                Images
            </h3>
            <div id="carouselImagesEdit" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    {# CASE 1: If no additional images exist, display the mandatory mainImage #}
                    {% if images|length == 0 %}
                        <div class="carousel-item active position-relative">
                            <img src="{{ asset('uploads/tricks/' ~ mainImage) }}" class="d-block w-100 rounded" style="height:300px; object-fit:cover;" alt="Main default image"></div>

                        {# CASE 2: Additional images exist, loop through them #}
                            {% else %}
                            {% for image in images %}
                                <div class="carousel-item {{ loop.first ? 'active' : '' }} position-relative">
                                    <img src="{{ asset('uploads/tricks/' ~ image.url) }}" class="d-block w-100 rounded" style="height:300px; object-fit:cover;" alt="Trick gallery image">

                                        {#
                                            SECURITY & LOGIC:
                                            1. Check if the user has permission to delete (Voter)
                                            2. CRITICAL: Prevent deletion if this specific image is set as the mainImage
                                        #}
                                        {% if is_granted('IMAGE_DELETE', image) and image.url != mainImage %}
                                            <form method="post" action="{{ path('app_image_delete', {id: image.id}) }}" class="position-absolute top-0 end-0 m-2" style="z-index:10;" onsubmit="return confirm('Are you sure you want to delete this image?');">

                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_image_' ~ image.id) }}">

                                                    <button type="submit" class="btn btn-danger btn-sm rounded-circle shadow">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            {% elseif image.url == mainImage %}
                                                {# Visual indicator that this image is protected #}
                                                <span class="badge bg-black position-absolute top-0 end-0 m-2 shadow" style="z-index:10;">
                                                    Main Image
                                                </span>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>

                            {# NAVIGATION : dispplay only if many additionnal images #}
                            {% if images|length > 1 %}
                                <button class="carousel-control-prev" type="button" data-bs-target="#carouselImagesEdit" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">
                                        Précédent
                                    </span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#carouselImagesEdit" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">
                                        Suivant
                                    </span>
                                </button>
                            {% endif %}
                        </div>
                    </div>
                    {# ======== CAROUSEL VIDEOS ========= #}
                    <div class="col-md-6">
                        <h3>
                            {{ videos|length }}
                            Vidéos
                        </h3>
                        <div id="carouselVideosEdit" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                {# CASE 1 : Display videos if exist #}
                                {% if videos|length > 0 %}
                                    {% for video in videos %}
                                        <div class="carousel-item {{ loop.first ? 'active' : '' }} position-relative">
                                            {# Ratio 16x9 for standard vidéo format#}
                                            <div class="ratio ratio-16x9">
                                                <iframe src="{{ video.embedUrl }}" style="pointer-events:none;" allowfullscreen></iframe>
                                            </div>
                                            {# Overlayfor modal opening #}
                                            <div class="position-absolute top-50 start-50 translate-middle" style="cursor:pointer; z-index:5;" data-bs-toggle="modal" data-bs-target="#modalVideo" onclick="openVideo('{{ video.embedUrl }}')">
                                                <i class="bi bi-play-circle-fill text-white" style="font-size:3rem; opacity: 0.8;"></i>
                                            </div>
                                            {# SECURITY : delete Btn with CSRF Token #}
                                            {% if is_granted('VIDEO_DELETE', video) %}
                                                <form method="post" action="{{ path('app_video_delete', {id: video.id}) }}" class="position-absolute top-0 end-0 m-2" style="z-index:10;" onsubmit="return confirm('Supprimer cette vidéo ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_video_' ~ video.id) }}">
                                                        <button class="btn btn-danger btn-sm rounded-circle">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    {# CAS 2 : display Message if anny video #}
                                        {% else %}
                                        <div class="carousel-item active text-center bg-light rounded" style="height:300px; display: flex; align-items: center; justify-content: center;">
                                            <p class="text-muted">
                                                <i class="bi bi-camera-video-off mb-2" style="font-size: 2rem; display: block;"></i>
                                                Aucune vidéo ajoutée. Vous pouvez en rajouter !
                                            </p>
                                        </div>
                                    {% endif %}
                                </div>
                                {# NAVIGATION :Display only if many videos #}
                                {% if videos|length > 1 %}
                                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselVideosEdit" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">
                                            Précédent
                                        </span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#carouselVideosEdit" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">
                                            Suivant
                                        </span>
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {# ================= VIDEOS PLAY MODALS ================= #}
                    <div class="modal fade" id="modalImage">
                        <div class="modal-dialog modal-xl modal-dialog-centered">
                            <div class="modal-content bg-dark">
                                <img id="modalImageContent" class="w-100"></div>
                            </div>
                        </div>
                        <div class="modal fade" id="modalVideo">
                            <div class="modal-dialog modal-xl modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="ratio ratio-16x9">
                                        <iframe id="modalVideoContent" allowfullscreen></iframe>
                                    </div>
                                </div>
                            </div>
                        </div>

