{{ form_start(form, {'attr': {'novalidate': 'novalidate',
        'enctype': 'multipart/form-data' }}
) }}
{# Name #}
<div class="mb-3">
    {{ form_label(form.name) }}
    {{ form_widget(form.name, {'attr': {'class': 'form-control' }}
    ) }}
    <div class="text-danger">
        {{ form_errors(form.name) }}
    </div>
</div>
{# Description #}
<div class="mb-3">
    {{ form_label(form.description) }}
    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5 }}
    ) }}
    <div class="text-danger">
        {{ form_errors(form.description) }}
    </div>
</div>
{# Main Image #}
<div class="mb-3">
    {{ form_label(form.mainImage) }}
    {{ form_widget(form.mainImage, 
        {'attr': {'class': 'form-control ' ~ (form.mainImage.vars.errors|length ? 'is-invalid' : '')} }) }}
    <div class="text-danger">
        {{ form_errors(form.mainImage) }}
    </div>
</div>
{# Additional Images #}
<div class="mb-3">
    {{ form_label(form.images) }}
    {{ form_widget(form.images, {'attr': {'class': 'form-control' }}
    ) }}
    <div class="text-danger">
        {{ form_errors(form.images) }}
    </div>
</div>
{# Videos #}
<div class="mb-3">
    {{ form_label(form.videos) }}
    {{ form_widget(form.videos, {
        'attr': {
            'class': 'form-control',
            'rows': 3,
            'placeholder': 'https://youtube.com/watch?v=xxx, https://youtu.be/xxx'
        }
    }) }}
    <div class="text-danger">
        {{ form_errors(form.videos) }}
    </div>
</div>
{# Groups #}
<div class="mb-3">
    {{ form_label(form.groups) }}
    {{ form_widget(form.groups, {'attr': {'class': 'form-select' }}
    ) }}
    <div class="text-danger">
        {{ form_errors(form.groups) }}
    </div>
</div>
{# IMPORTANT : CSRF + champs cachés #}
{{ form_rest(form) }}
{# Submit button #}
<button class="btn btn-success w-100 mt-3">
    <i class="bi bi-check-lg"></i>
    {{ button_label|default('Ajouter') }}
</button>
{{ form_end(form) }}
