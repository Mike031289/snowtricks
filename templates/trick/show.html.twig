{% extends 'base.html.twig' %}
{% block title %}
    {{ trick.name }}
    - SnowTricks
{% endblock %}
{% block body %}
    <div class="container mt-4">
        {# HERO IMAGE #}
        <div class="position-relative mb-4">
            <img src="{{ asset('uploads/images/' ~ trick.mainImage) }}" class="img-fluid w-100 rounded shadow" style="max-height: 400px; object-fit: cover;" alt="{{ trick.name }}">
                <h1 class="position-absolute bottom-0 start-0 text-white p-3" style="background: rgba(0,0,0,0.5); width: 100%;">
                    {{ trick.name }}
                </h1>
            </div>
            {# INFOS #}
            <div class="mb-3 text-muted">
                <span>
                    <i class=""></i>
                    {{ trick.author.username }}
                </span>
                |
                <span>
                    <i class=""></i>
                    {{ trick.createdAt|date('d/m/Y') }}
                </span>
                |
                <span>
                    <i class=""></i>
                    {{ trick.groups.name }}
                </span>
            </div>
            {# DESCRIPTION #}
            <div class="mb-4">
                <p>
                    {{ trick.description }}
                </p>
            </div>
            {# GALLERY IMAGES #}
            <h3 class="mb-3">
                <i class=""></i>
                Images
            </h3>
            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    {#  Main Image by default #}
                    <img src="{{ asset('uploads/images/' ~ trick.mainImage) }}" class="img-fluid rounded shadow-sm" style="height:150px; object-fit:cover;" alt="{{ trick.mainImage }}">
                        <p class="small text-muted">
                            Image principale par défaut:
                            {{ trick.mainImage }}
                        </p>
                    </div>
                    {% for image in trick.images %}
                        <div class="col-md-3 mb-3">
                            <img src="{{ asset('uploads/images/' ~ image.url) }}" class="img-fluid rounded shadow-sm" alt="{{ image.alt }}" style="height:150px; object-fit:cover;">
                                <p class="small text-muted">
                                    Image :
                                    {{ trick.mainImage }}
                                </p>
                            </div>
                        {% endfor %}
                    </div>
                    {# VIDEOS #}
                    <h3 class="mb-3">
                        <i class=""></i>
                        Vidéos
                    </h3>
                    <div class="row mb-4">
                        {% for video in trick.videos %}
                            <div class="col-md-4 mb-3">
                                <div class="ratio ratio-16x9">
                                    <iframe src="{{ video.embedUrl | replace({'watch?v=': 'embed/'}) }}" title="YouTube video" allowfullscreen></iframe>
                                </div>
                            </div>
                        {% else %}
                            <p>
                                Aucune vidéo disponible.
                            </p>
                        {% endfor %}
                    </div>
                    {# COMMENTS #}
                    {# add comment form #}
                    {% if app.user %}
                        <h4>
                            Laisser un commentaire
                        </h4>
                        {{ form_start(commentForm) }}
                        {{ form_widget(commentForm.content) }}
                        <button class="btn btn-primary mt-2">
                            Commenter
                        </button>
                        {{ form_end(commentForm) }}
                    {% else %}
                        <p>
                            Veuillez vous connecter pour laisser un commentaire.
                        </p>
                    {% endif %}
                    {# list comments with author and date and content  #}
                    <h3 class="mt-4">
                        {{ trick.comments|length }}
                            Commentaires
                    </h3>
                    {% for comment in comments %}
                        <div class="border rounded p-3 mb-2">
                            <strong>
                                {{ comment.author.username }}
                            </strong>
                            <small class="text-muted">
                                {{ comment.createdAt|date('d/m/Y H:i') }}
                            </small>
                            <p class="mb-2">
                                {{ comment.content }}
                            </p>
                            {% if app.user and comment.author == app.user %}
                                <a href="{{ path('app_comment_edit', {id: comment.id}) }}" class="btn btn-sm btn-warning">
                                    <i class=""></i>
                                    Modifier
                                </a>
                                <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}" style="display:inline;" onsubmit="return confirm('Delete this comment?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                        <button class="btn btn-sm btn-danger">
                                            <i class=""></i>
                                            Delete
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        {% else %}
                            <p>
                                Aucun commentaire pour le moment. Soyez le premier à commenter !
                            </p>
                        {% endfor %}
                        {% if totalPages > 1 %}
                            <nav class="mt-3">
                                <ul class="pagination justify-content-center">
                                    {# Previous #}
                                    <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                                        <a class="page-link" href="{{ path('app_trick_show', {slug: trick.slug, page: currentPage - 1}) }}">
                                            ←
                                        </a>
                                    </li>
                                    {# Pages #}
                                    {% for i in max(1, currentPage - 2)..min(totalPages, currentPage + 2) %}
                                        <li class="page-item {{ currentPage == i ? 'active' }}">
                                            <a class="page-link" href="{{ path('app_trick_show', {slug: trick.slug, page: i}) }}">
                                                {{ i }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                    {# Next #}
                                    <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                                        <a class="page-link" href="{{ path('app_trick_show', {slug: trick.slug, page: currentPage + 1}) }}">
                                            →
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        {% endif %}
                    </div>
                {% endblock %}
                