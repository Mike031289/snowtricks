{% extends 'base.html.twig' %}
{% block title %}
    {{ trick.name }}
    - SnowTricks
{% endblock %}
{% block body %}
    <div class="container mt-4">
        {# HERO IMAGE #}
        <div class="position-relative mb-4">
            <img src="{{ asset('uploads/images/' ~ trick.mainImage) }}" class="img-fluid w-100 rounded shadow" style="max-height: 400px; object-fit: cover;" alt="{{ trick.name }}">
                <h1 class="position-absolute bottom-0 start-0 text-white p-3" style="background: rgba(0,0,0,0.5); width: 100%;">
                    {{ trick.name }}
                </h1>
            </div>
            {# INFOS #}
            <div class="mb-3 text-muted">
                <span>
                    <i class=""></i>
                    {{ trick.author.username }}
                </span>
                |
                <span>
                    <i class=""></i>
                    {{ trick.createdAt|date('d/m/Y') }}
                </span>
                |
                <span>
                    <i class=""></i>
                    {{ trick.groups.name }}
                </span>
            </div>
            {# DESCRIPTION #}
            <div class="mb-4">
                <p>
                    {{ trick.description }}
                </p>
            </div>
            {# GALLERY IMAGES #}
            <h3 class="mb-3">
                <i class=""></i>
                Images
            </h3>
            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    {#  Main Image by default #}
                    <img src="{{ asset('uploads/images/' ~ trick.mainImage) }}" class="img-fluid rounded shadow-sm" style="height:150px; object-fit:cover;" alt="{{ trick.mainImage }}">
                        <p class="small text-muted">
                            Image principale par défaut:
                            {{ trick.mainImage }}
                        </p>
                    </div>
                    {% for image in trick.images %}
                        <div class="col-md-3 mb-3">
                            <img src="{{ asset('uploads/images/' ~ image.url) }}" class="img-fluid rounded shadow-sm" alt="{{ image.alt }}" style="height:150px; object-fit:cover;">
                                <p class="small text-muted">
                                    Image :
                                    {{ trick.mainImage }}
                                </p>
                            </div>
                        {% endfor %}
                    </div>
                    {# VIDEOS #}
                    <h3 class="mb-3">
                        <i class=""></i>
                        Vidéos
                    </h3>
                    <div class="row mb-4">
                        {% for video in trick.videos %}
                            <div class="col-md-4 mb-3">
                                <div class="ratio ratio-16x9">
                                    <iframe src="{{ video.embedUrl }}" title="YouTube video" allowfullscreen></iframe>
                                </div>
                            </div>
                        {% else %}
                            <p>
                                Aucune vidéo disponible.
                            </p>
                        {% endfor %}
                    </div>
                    {# COMMENTS #}
                    {# add comment form #}
                    {% if is_granted('ROLE_USER') %}
                        <h4>
                            Laisser un commentaire
                        </h4>
                        {{ form_start(commentForm) }}
                        {{ form_widget(commentForm.content) }}
                        <button class="btn btn-primary mt-2">
                            <i class="bi bi-chat-dots"></i>
                            Commenter
                        </button>
                        {{ form_end(commentForm) }}
                    {% else %}
                        <div class="alert alert-secondary " role="alert">
                            Veuillez vous
                            <a class="alert-link m-2 text-primary" href="{{ path('app_login') }}">
                                connecter
                            </a>
                            pour laisser un commentaire.
                        </div>
                    {% endif %}
                    {# ================= COMMENTS ================= #}
                    <h4 class="mt-5 mb-4">
                        💬
                        {{ comments|length }}
                        commentaire
                        {{ comments|length > 1 ? 's' : '' }}
                    </h4>
                    {% for comment in comments %}
                        <div class="card mb-3 shadow-sm border-0">
                            <div class="card-body d-flex gap-3">
                                {# ===== AVATAR ===== #}
                                <div>
                                    {% if comment.author.avatar %}
                                        <img
                                        src="{{ asset('uploads/avatars/' ~ comment.author.avatar) }}" class="rounded-circle" style="width:50px;height:50px;object-fit:cover;">
                                            {% else %}
                                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;">
                                                <i class="bi bi-person text-muted"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                    {# ===== CONTENT ===== #}
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>
                                                    {{ comment.author.username }}
                                                </strong>
                                                <br>
                                                    {% if comment.updatedAt and comment.updatedAt != comment.createdAt %}
                                                        <small class="text-muted">
                                                            Modifié le
                                                            {{ comment.updatedAt|date('d/m/Y à H:i') }}
                                                        </small>
                                                    {% else %}
                                                        <small class="text-muted">
                                                            Publié le
                                                            {{ comment.createdAt|date('d/m/Y à H:i') }}
                                                        </small>
                                                    {% endif %}
                                                </div>
                                                {# ACTIONS #}
                                                <div class="d-flex gap-2">
                                                    {% if is_granted('COMMENT_EDIT', comment) %}
                                                        <a href="{{ path('app_comment_edit', {id: comment.id}) }}" class="text-warning">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                    {% endif %}
                                                    {% if is_granted('COMMENT_DELETE', comment) %}
                                                        <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                                                <button class="btn btn-link text-danger p-0">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </form>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <p class="mt-3 mb-0">
                                                    {{ comment.content }}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="text-center text-muted py-4">
                                        <i class="bi bi-chat-dots fs-2"></i>
                                        <p class="mt-2">
                                            Aucun commentaire pour le moment
                                        </p>
                                    </div>
                                {% endfor %}
                                {% if totalPages > 1 %}
                                    <nav class="mt-3">
                                        <ul class="pagination justify-content-center">
                                            {# PREVIOUS #}
                                            <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                                                <a class="page-link" href="{{ path('app_trick_show', {
                                                        id: trick.id,
                                                        slug: trick.slug,
                                                        page: currentPage - 1
                                                    }) }}">
                                                    ←
                                                </a>
                                            </li>
                                            {# PAGES #}
                                            {% for i in 1..totalPages %}
                                                <li class="page-item {{ currentPage == i ? 'active' }}">
                                                    <a class="page-link" href="{{ path('app_trick_show', {
                                                            id: trick.id,
                                                            slug: trick.slug,
                                                            page: i
                                                        }) }}">
                                                        {{ i }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                            {# NEXT #}
                                            <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                                                <a class="page-link" href="{{ path('app_trick_show', {
                                                    id: trick.id,
                                                    slug: trick.slug,
                                                    page: currentPage + 1
                                                }) }}">
                                                    →
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                {% endif %}
                            </div>
                        {% endblock %}
                        