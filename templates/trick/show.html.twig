{% extends 'base.html.twig' %}
{% block title %}
    {{ trick.name }}
    - SnowTricks
{% endblock %}
{% block body %}
    <div class="container mt-4">
        {# HERO IMAGE #}
        <div class="position-relative mb-4">
            <img src="{{ asset('uploads/tricks/' ~ trick.mainImage) }}" class="img-fluid w-100 rounded shadow" style="max-height: 400px; object-fit: cover;" alt="{{ trick.name }}">
                <h1 class="position-absolute bottom-0 start-0 text-white p-3" style="background: rgba(0,0,0,0.5); width: 100%;">
                    {{ trick.name }}
                </h1>
            </div>
            {# INFOS #}
            <div class="mb-3 text-muted">
                {{ trick.author.username }}
                |
                {{ trick.createdAt|date('d/m/Y') }}
                |
                {{ trick.groups.name }}
            </div>
            {# DESCRIPTION #}
            <div class="mb-4">
                <p>
                    {{ trick.description }}
                </p>
            </div>
            {# ========== BLOCK SEPARATOR ======= #}
            <div class="container d-flex my-5" style="max-width: 700px;">
                <hr class="flex-grow-1 my-4">
                    <span class="px-3 text-muted text-primary">
                        <h1>
                            Médias
                        </h1>
                    </span>
                    <hr class="flex-grow-1 my-4"></div>
                    {# ========= CAROUSELS ======= #}
                    <div class="row mb-4">
                        {# IMAGES #}
                        <div class="col-md-6">
                            <h3>
                                {{ trick.images|length }}
                                Images
                            </h3>
                            <div class="mb-3 text-muted">
                                Clicker sur une image pour la visualiser
                            </div>
                            <div id="carouselImages" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    <div class="carousel-item active">
                                        <img src="{{ asset('uploads/tricks/' ~ trick.mainImage) }}" class="d-block w-100 rounded" style="height:300px; object-fit:cover; cursor:pointer;" onclick="openImage(this.src)" data-bs-toggle="modal" data-bs-target="#modalImage"></div>
                                        {% for image in trick.images %}
                                            <div class="carousel-item">
                                                <img src="{{ asset('uploads/tricks/' ~ image.url) }}" class="d-block w-100 rounded" style="height:300px; object-fit:cover; cursor:pointer;" onclick="openImage(this.src)" data-bs-toggle="modal" data-bs-target="#modalImage"></div>
                                            {% endfor %}
                                        </div>
                                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselImages" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#carouselImages" data-bs-slide="next">
                                            <span class="carousel-control-next-icon"></span>
                                        </button>
                                    </div>
                                </div>
                                {# VIDEOS #}
                                <div class="col-md-6">
                                    <h3>
                                        {{ trick.videos|length }}
                                        Vidéos
                                    </h3>
                                    <div class="mb-3 text-muted">
                                        Clicker sur une video pour la visualiser ou partager
                                    </div>
                                    <div id="carouselVideos" class="carousel slide" data-bs-ride="carousel">
                                        <div class="carousel-inner">
                                            {% for video in trick.videos %}
                                                <div class="carousel-item {{ loop.first ? 'active' }}">
                                                    <div class="position-relative">
                                                        <div class="ratio ratio-16x9">
                                                            <iframe src="{{ video.embedUrl }}" style="pointer-events:none;" allowfullscreen class="w-100 h-100 rounded" tabindex="-1"></iframe>
                                                        </div>
                                                        <div class="position-absolute top-50 start-50 translate-middle" onclick="openVideo('{{ video.embedUrl }}')" data-bs-toggle="modal" data-bs-target="#modalVideo" style="cursor:pointer;">
                                                            <i class="bi bi-play-circle-fill text-white" style="font-size:3rem;"></i>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% else %}
                                                <div class="carousel-item active text-center">
                                                    <p>
                                                        Aucune vidéo disponible
                                                    </p>
                                                </div>
                                            {% endfor %}
                                        </div>
                                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselVideos" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#carouselVideos" data-bs-slide="next">
                                            <span class="carousel-control-next-icon"></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            {# ========= COMMENT Block ======= #}
                            <div class="comments-block">
                                {# ========= COMMENT FORM ======= #}
                                {% if is_granted('ROLE_USER') %}
                                    <h4 class="mt-5">
                                        Laisser un commentaire
                                    </h4>
                                    {{ include('comment/_form.html.twig') }}
                                {% else %}
                                    <div class="alert alert-secondary">
                                        Veuillez vous
                                        <a href="{{ path('app_login') }}" class="alert-link text-primary">
                                            connecter
                                        </a>
                                    </div>
                                {% endif %}
                                {# ======== COMMENTS ======== #}
                                <h4 class="mt-5 mb-4">
                                    💬
                                    {{ comments|length }}
                                    commentaire(s)
                                </h4>
                                {% for comment in comments %}
                                    <div class="card mb-3 shadow-sm border-0">
                                        <div class="card-body d-flex gap-3">
                                            {# AVATAR #}
                                            <div>
                                                {% if comment.author.avatar %}
                                                    <img
                                                    src="{{ asset('uploads/avatars/' ~ comment.author.avatar) }}" class="rounded-circle" style="width:50px;height:50px;object-fit:cover;">
                                                        {% else %}
                                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;">
                                                            <i class="bi bi-person"></i>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                                {# CONTENT #}
                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between">
                                                        <div>
                                                            <strong>
                                                                {{ comment.author.username }}
                                                            </strong>
                                                            <br>
                                                                <small class="text-muted">
                                                                    {% if comment.updatedAt and comment.updatedAt != comment.createdAt %}
                                                                        Modifié le
                                                                        {{ comment.updatedAt|date('d/m/Y H:i') }}
                                                                    {% else %}
                                                                        Publié le
                                                                        {{ comment.createdAt|date('d/m/Y H:i') }}
                                                                    {% endif %}
                                                                </small>
                                                            </div>
                                                            <div class="d-flex gap-2">
                                                                {% if is_granted('COMMENT_EDIT', comment) %}
                                                                    <a href="{{ path('app_comment_edit', {id: comment.id}) }}" class="text-warning">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </a>
                                                                {% endif %}
                                                                {% if is_granted('COMMENT_DELETE', comment) %}
                                                                    <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}">
                                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                                                            <button class="btn btn-link text-danger p-0">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        </form>
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                            <p class="mt-2 mb-0">
                                                                {{ comment.content }}
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% else %}
                                                <div class="text-center text-muted py-4">
                                                    <i class="bi bi-chat-dots fs-2"></i>
                                                    <p>
                                                        Aucun commentaire
                                                    </p>
                                                </div>
                                            {% endfor %}
                                        </div>
                                        {# ======= PAGINATION RESTORED ======== #}
                                        {% if totalPages > 1 %}
                                            <nav class="mt-4">
                                                <ul class="pagination justify-content-center">
                                                    <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                                                        <a class="page-link" href="{{ path('app_trick_show', {
                                                        id: trick.id,
                                                        slug: trick.slug,
                                                        page: currentPage - 1
                                                    }) }}">
                                                            ←
                                                        </a>
                                                    </li>
                                                    {% for i in 1..totalPages %}
                                                        <li class="page-item {{ currentPage == i ? 'active' }}">
                                                            <a class="page-link" href="{{ path('app_trick_show', {
                                                            id: trick.id,
                                                            slug: trick.slug,
                                                            page: i
                                                        }) }}">
                                                                {{ i }}
                                                            </a>
                                                        </li>
                                                    {% endfor %}
                                                    <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                                                        <a class="page-link" href="{{ path('app_trick_show', {
                                                        id: trick.id,
                                                        slug: trick.slug,
                                                        page: currentPage + 1
                                                    }) }}">
                                                            →
                                                        </a>
                                                    </li>
                                                </ul>
                                            </nav>
                                        {% endif %}
                                    </div>
                                    {# ========= MODALS ========= #}
                                    <div class="modal fade" id="modalImage" tabindex="-1">
                                        <div class="modal-dialog modal-xl modal-dialog-centered">
                                            <div class="modal-content bg-dark">
                                                <img id="modalImageContent" class="w-100"></div>
                                            </div>
                                        </div>
                                        <div class="modal fade" id="modalVideo" tabindex="-1">
                                            <div class="modal-dialog modal-xl modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="ratio ratio-16x9">
                                                        <iframe id="modalVideoContent" allowfullscreen></iframe>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endblock %}
                                    