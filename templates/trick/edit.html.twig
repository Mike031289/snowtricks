{% extends 'base.html.twig' %}
{% block title %}
    Modifier
    {{ trick.name }}
    - SnowTricks
{% endblock %}
{% block body %}
    <div class="container mt-4 mb-5">
        {% if is_granted('ROLE_USER') %}
            <img src="{{ asset('uploads/tricks/' ~ mainImage) }}" class="img-fluid w-100 rounded shadow" style="max-height:400px; object-fit:cover;"></div>
        {% endif %}
        {# ================= FORM ================= #}
        <div class="container my-5">
            <h1 class="mb-4">
                <i class="bi bi-pencil-square"></i>
                Modifier la figure
            </h1>
            {{ include('trick/_form.html.twig') }}
        </div>
        {# ================= BLOCK SEPARATOR ================= #}
        <div class="container d-flex my-5" style="max-width: 700px;">
            <hr class="flex-grow-1 my-4">
                <span class="px-3 text-muted text-primary">
                    <h1>
                        Médias
                    </h1>
                </span>
                <hr class="flex-grow-1 my-4"></div>
                {# ================= CAROUSEL IMAGES ================= #}
                <div class="position-relative mb-4">
                    <div class="row mt-5 mb-4">
                        <div class="col-md-6">
                            <h3>
                                {{ images|length }}
                                Images
                            </h3>
                            <div id="carouselImagesEdit" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    <div class="carousel-item active position-relative">
                                        <img src="{{ asset('uploads/tricks/' ~ mainImage) }}" class="d-block w-100 rounded" style="height:300px; object-fit:cover;"></div>
                                        {% for image in images %}
                                            <div class="carousel-item position-relative">
                                                <img src="{{ asset('uploads/tricks/' ~ image.url) }}" class="d-block w-100 rounded" style="height:300px; object-fit:cover;">
                                                    {% if is_granted('IMAGE_DELETE', image) %}
                                                        <form method="post" action="{{ path('app_image_delete', {id: image.id}) }}" class="position-absolute top-0 end-0 m-2" style="z-index:10;" onsubmit="return confirm('Supprimer cette image ?');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_image_' ~ image.id) }}">
                                                                <button class="btn btn-danger btn-sm rounded-circle">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            </form>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselImagesEdit" data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon"></span>
                                            </button>
                                            <button class="carousel-control-next" type="button" data-bs-target="#carouselImagesEdit" data-bs-slide="next">
                                                <span class="carousel-control-next-icon"></span>
                                            </button>
                                        </div>
                                    </div>
                                    {# ================= CAROUSEL VIDEOS ================= #}
                                    <div class="col-md-6">
                                        <h3>
                                            {{ videos|length }}
                                            Vidéos
                                        </h3>
                                        <div id="carouselVideosEdit" class="carousel slide" data-bs-ride="carousel">
                                            <div class="carousel-inner">
                                                {% for video in videos %}
                                                    <div class="carousel-item {% if loop.first %}active{% endif %} position-relative">
                                                        <div class="ratio ratio-16x9">
                                                            <iframe src="{{ video.embedUrl }}" style="pointer-events:none;" allowfullscreen></iframe>
                                                        </div>
                                                        <div class="position-absolute top-50 start-50 translate-middle" style="cursor:pointer;" data-bs-toggle="modal" data-bs-target="#modalVideo" onclick="openVideo('{{ video.embedUrl }}')">
                                                            <i class="bi bi-play-circle-fill text-white" style="font-size:3rem;"></i>
                                                        </div>
                                                        {% if is_granted('VIDEO_DELETE', video) %}
                                                            <form method="post" action="{{ path('app_video_delete', {id: video.id}) }}" class="position-absolute top-0 end-0 m-2" style="z-index:10;" onsubmit="return confirm('Supprimer cette vidéo ?');">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_video_' ~ video.id) }}">
                                                                    <button class="btn btn-danger btn-sm rounded-circle">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                </form>
                                                            {% endif %}
                                                        </div>
                                                    {% else %}
                                                        <div class="carousel-item active text-center">
                                                            <p>
                                                                Aucune vidéo
                                                            </p>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                                <button class="carousel-control-prev" type="button" data-bs-target="#carouselVideosEdit" data-bs-slide="prev">
                                                    <span class="carousel-control-prev-icon"></span>
                                                </button>
                                                <button class="carousel-control-next" type="button" data-bs-target="#carouselVideosEdit" data-bs-slide="next">
                                                    <span class="carousel-control-next-icon"></span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {# ================= MODALS ================= #}
                                <div class="modal fade" id="modalImage">
                                    <div class="modal-dialog modal-xl modal-dialog-centered">
                                        <div class="modal-content bg-dark">
                                            <img id="modalImageContent" class="w-100"></div>
                                        </div>
                                    </div>
                                    <div class="modal fade" id="modalVideo">
                                        <div class="modal-dialog modal-xl modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="ratio ratio-16x9">
                                                    <iframe id="modalVideoContent" allowfullscreen></iframe>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endblock %}
                                