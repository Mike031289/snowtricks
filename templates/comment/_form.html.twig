{% if is_granted('ROLE_USER') %}
    {{ form_start(commentForm, {
        'attr': {
            'novalidate': 'novalidate',
            'data-turbo': 'false'
        }
    }) }}
    {# ===== CONTENT ===== #}
    <div class="">
        {{ form_label(commentForm.content) }}
        {{ form_widget(commentForm.content, {
                'attr': {
                    'class': 'form-control ' ~ (commentForm.content.vars.errors|length ? 'is-invalid' : ''),
                    'rows': 3,
                    'placeholder': 'Ajoutez votre commentaire...'
                }
            }) }}
        <div class="invalid-feedback d-block">
            {{ form_errors(commentForm.content) }}
        </div>
        <div class="form-text text-muted text-end">
            <span id="charCount">
                0
            </span>
            / 1000 caractères
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary flex-fill">
            <i class="bi bi-chat-dots me-1"></i>
            Commenter
        </button>
        {# Conditions for displaying the back button. If the user is on the “Show Trick” page, do not display the button; otherwise, if they are on the “Edit Comment” page, the back button can be displayed. #}
        {% if comment is defined and comment.trick is defined %}
            <a href="{{ path('app_trick_show', {
            id: comment.trick.id,
            slug: comment.trick.slug
        }) }}" class="btn btn-outline-secondary flex-fill">
                <i class="bi bi-arrow-left me-1"></i>
                Annuler
            </a>
        {% endif %}
    </div>
    {{ form_end(commentForm) }}
{% endif %}
