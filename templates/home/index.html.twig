{% extends 'base.html.twig' %}
{% block title %}
    Accueil - SnowTricks
{% endblock %}
{% block body %}
    {% if app.user %}
        <btn class="btn btn-sm btn-success mb-4 float-end">
            <a class="nav-link" href="{{ path('app_trick_new') }}">
                Ajouter un trick
            </a>
        </btn>
    {% endif %}
    <h1 class="mb-4">
        Bienvenue sur SnowTricks !
    </h1>
    <div class="container mt-5">
        <h1 class="text-center mb-5">
            Liste des Tricks
        </h1>
        <div class="row">
            {% for trick in tricks %}
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm">
                        {# Image principale #}
                        <img src="{{ asset('uploads/images/' ~ trick.mainImage) }}" class="card-img-top" alt="{{ trick.name }}">
                            <div class="card-body text-center">
                                <h5 class="card-title">
                                    {{ trick.name }}
                                </h5>
                                <a href="{{ path('app_trick_show', {slug: trick.slug}) }}" class="btn btn-primary btn-sm">
                                    Voir
                                </a>
                            {# {% if app.user %}
                                <a href="{{ path('app_trick_edit', {id: trick.id}) }}" class="btn btn-warning btn-sm">
                                Edit
                                </a>
                                <a href="{{ path('app_trick_delete', {id: trick.id}) }}" class="btn btn-danger btn-sm">
                                Delete
                                </a>
                            {% endif %} #}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center">
                        Aucun trick disponible.
                    </p>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
