{% extends 'base.html.twig' %}
{% block title %}
    Accueil - SnowTricks
{% endblock %}
{% block body %}
    {% if app.user %}
        <a href="{{ path('app_trick_new') }}" class="btn btn-success mb-4 float-end">
            <i class="bi bi-plus"></i>
            Ajouter un trick
        </a>
    {% endif %}
    <h1 class="mb-4">
        Bienvenue sur SnowTricks !
    </h1>
    <div class="container mt-5">
        <h1 class="text-center mb-5">
            Liste des Tricks
        </h1>
        <div class="row">
            {% for trick in tricks %}
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm">
                        {# Image principale #}
                        <img src="{{ asset('uploads/images/' ~ trick.mainImage) }}" class="card-img-top" alt="{{ trick.name }}">
                            <div class="card-body text-center">
                                <h5 class="card-title">
                                    {{ trick.name }}
                                </h5>
                                <a href="{{ path('app_trick_show', {slug: trick.slug}) }}" class="btn btn-primary btn-sm">
                                    <i class="bi bi-eye"></i>
                                    Afficher
                                </a>
                                {% if app.user and app.user == trick.author %}
                                    <div class="mt-2">
                                        <a href="{{ path('app_trick_edit', {slug: trick.slug}) }}" class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil"></i>
                                            Modifier
                                        </a>
                                        {# DELETE sécurisé avec formulaire #}
                                        <form method="post" action="{{ path('app_trick_delete', {slug: trick.slug}) }}" style="display:inline-block;" onsubmit="return confirm('Tu es sûr de vouloir supprimer ce trick ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ trick.slug) }}">
                                                <button class="btn btn-danger btn-sm">
                                                    <i class="bi bi-trash"></i>
                                                    Supprimer
                                                </button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-center">
                            Aucun trick disponible.
                        </p>
                    {% endfor %}
                    {# ===================== PAGINATION ===================== #}
                    {% if totalPages > 1 %}
                        <nav class="mt-4">
                            <ul class="pagination justify-content-center">
                                {# Previous #}
                                <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                                    <a class="page-link" href="{{ path('app_home', {page: currentPage - 1}) }}">
                                        ←
                                    </a>
                                </li>
                                {# Pages #}
                                {% for i in 1..totalPages %}
                                    <li class="page-item {{ currentPage == i ? 'active' }}">
                                        <a class="page-link" href="{{ path('app_home', {page: i}) }}">
                                            {{ i }}
                                        </a>
                                    </li>
                                {% endfor %}
                                {# Next #}
                                <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                                    <a class="page-link" href="{{ path('app_home', {page: currentPage + 1}) }}">
                                        →
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    {% endif %}
                </div>
            {% endblock %}
            